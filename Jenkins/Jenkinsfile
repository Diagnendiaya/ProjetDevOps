
pipeline {
    agent any

    stages {
        stage('Build et tests JUnit') {
            steps {
                sh 'mvn -B -f backend/pom.xml -version'

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {
                    sh 'mvn -B -f backend/pom.xml clean test'
                    sh 'mvn -B -f backend/pom.xml surefire-report:report'
                }
            }

            post {
                always {
                    junit(
                        testResults: 'backend/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: true
                    )

                    archiveArtifacts(
                        artifacts: 'backend/target/reports/surefire.html',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }
}
