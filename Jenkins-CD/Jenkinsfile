
pipeline {
    agent any

    stages {  

      stage('Deploy with Ansible') {
    		steps {
        		withCredentials([
            		usernamePassword(
                	credentialsId: 'dockerhub-credentials',
                	usernameVariable: 'DOCKERHUB_USER',
                	passwordVariable: 'DOCKERHUB_TOKEN'
            		),
					sshUserPrivateKey(
                	credentialsId: 'ansible-ssh',
                	keyFileVariable: 'SSH_KEY',
                	usernameVariable: 'SSH_USER'
            		)
        		]) {			
					sh '''
                	set +x
                	cd ansible
					ansible-playbook \
                  -i inventory.ini \
                  playbook.yml \
                  --private-key "$SSH_KEY" \
                  -u "$SSH_USER"
            		'''
        			}

    		}
      

      

    }
}
}
