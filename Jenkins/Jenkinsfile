pipeline {
    agent any

    stages {
        stage('Build et tests JUnit') {
            steps {
                sh 'mvn -B -f backend/pom.xml -version'
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                sh 'mvn -B -f backend/pom.xml clean test'
                sh 'mvn -B -f backend/pom.xml surefire-report:report'
                    
                }
            }
            post {
        always {
            junit testResults: 'backend/target/surefire-reports/TEST-*.xml',
                  allowEmptyResults: true
            publishHTML(target: [
                reportName: 'Rapport JUnit',
                reportDir: 'backend/target/reports',
                reportFiles: 'surefire.html',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])
        }
    }

            
        }
/*
        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh "${scannerHome}/bin/sonar-scanner"
                    }
                }
            }
        }
    */
    }


}
